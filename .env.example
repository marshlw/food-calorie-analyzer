# ─────────────────────────────────────────────────────────────────────────────
# Пример окружения. Скопируй в .env и подставь СВОИ значения.
# .env НЕ коммитим (см. .gitignore). Секреты ниже — сгенерируй заново.
# ─────────────────────────────────────────────────────────────────────────────

# ===================== БАЗА ДАННЫХ (ПРОД) =====================
# Пароль суперпользователя postgres. Сгенерируй:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
POSTGRES_PASSWORD=CHANGE_ME_strong_superuser_password

# Пароль прикладного пользователя fooduser (его использует API).
# Должен совпадать с паролем в DATABASE_URL ниже. Сгенерируй отдельно:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
APP_DB_PASSWORD=CHANGE_ME_strong_app_db_password

# Строка подключения API. Пароль здесь = APP_DB_PASSWORD.
# Приложение НЕ стартует, если тут слабый/дефолтный пароль (foodpass, adminpass...).
DATABASE_URL=postgresql+psycopg2://fooduser:CHANGE_ME_strong_app_db_password@postgres:5432/fooddb

# Разрешить слабый пароль БД — ТОЛЬКО для dev/test. В проде НЕ задавать.
# ALLOW_INSECURE_DB_PASSWORD=false

# ===================== БЕЗОПАСНОСТЬ =====================
# Ключ подписи JWT. Сгенерируй:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=CHANGE_ME_strong_jwt_secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
ENABLE_DOCS=false

# ===================== REDIS =====================
REDIS_HOST=redis
REDIS_PORT=6379
CACHE_TTL=86400

# ===================== МОДЕЛЬ (провайдер распознавания) =====================
MODEL_PROVIDER=yandex
YANDEX_API_KEY=CHANGE_ME
YANDEX_FOLDER_ID=CHANGE_ME

# ===================== ПРОЧЕЕ =====================
DOMAIN=example.com
ADMIN_TOKEN=CHANGE_ME
TELEGRAM_BOT_TOKEN=CHANGE_ME
MAX_UPLOAD_SIZE=10485760
UPLOAD_DIR=/app/app/uploads
API_URL=http://api:8000
