{
  "info": {
    "name": "AI-Healthy API Collection",
    "description": "Complete API collection for AI-Healthy health tracking application",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Health Check",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/health",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "health"
              ]
            },
            "description": "Check if the API is running"
          },
          "response": []
        }
      ]
    },
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"user@example.com\",\n  \"password\": \"password123\",\n  \"full_name\": \"John Doe\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/register",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "register"
              ]
            },
            "description": "Register a new user"
          },
          "response": []
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/x-www-form-urlencoded"
              }
            ],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "email",
                  "value": "user@example.com",
                  "type": "text"
                },
                {
                  "key": "password",
                  "value": "password123",
                  "type": "text"
                },
                {
                  "key": "grant_type",
                  "value": "password",
                  "type": "text"
                }
              ]
            },
            "url": {
              "raw": "{{base_url}}/api/v1/login",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "login"
              ]
            },
            "description": "Login with email and password"
          },
          "response": []
        },
        {
          "name": "Refresh Token",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/x-www-form-urlencoded"
              }
            ],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "grant_type",
                  "value": "refresh_token",
                  "type": "text"
                },
                {
                  "key": "refresh_token",
                  "value": "{{refresh_token}}",
                  "type": "text"
                }
              ]
            },
            "url": {
              "raw": "{{base_url}}/api/v1/token",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "token"
              ]
            },
            "description": "Refresh access token using refresh token"
          },
          "response": []
        },
        {
          "name": "Get Current User",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/me",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "me"
              ]
            },
            "description": "Get current authenticated user information"
          },
          "response": []
        }
      ]
    },
    {
      "name": "Image Analysis",
      "item": [
        {
          "name": "Analyze Food Image",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}",
                "type": "text"
              }
            ],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file",
                  "src": []
                }
              ]
            },
            "url": {
              "raw": "{{base_url}}/api/v1/analyze",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "analyze"
              ]
            },
            "description": "Upload and analyze a food image. Returns a task ID."
          },
          "response": []
        },
        {
          "name": "Get Task Status",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/task/{{task_id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "task",
                "{{task_id}}"
              ]
            },
            "description": "Get the status and results of an analysis task"
          },
          "response": []
        },
        {
          "name": "Get User Tasks",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/tasks?limit=50&offset=0",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "tasks"
              ],
              "query": [
                {
                  "key": "limit",
                  "value": "50"
                },
                {
                  "key": "offset",
                  "value": "0"
                }
              ]
            },
            "description": "Get all analysis tasks for the current user"
          },
          "response": []
        }
      ]
    },
    {
      "name": "Meals",
      "item": [
        {
          "name": "Add Meal Entry",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"food_name\": \"Grilled Chicken Breast\",\n  \"calories\": 165,\n  \"protein_g\": 31,\n  \"fat_g\": 3.6,\n  \"carbs_g\": 0,\n  \"weight_g\": 100,\n  \"meal_type\": \"breakfast\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/meals",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "meals"
              ]
            },
            "description": "Add a new meal entry"
          },
          "response": []
        },
        {
          "name": "Add Meal from Analysis",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"task_id\": \"{{task_id}}\",\n  \"meal_type\": \"lunch\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/meals/from-analysis",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "meals",
                "from-analysis"
              ]
            },
            "description": "Create a meal entry from image analysis results"
          },
          "response": []
        },
        {
          "name": "Get Daily Log",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/daily-log?date_str=2024-05-25",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "daily-log"
              ],
              "query": [
                {
                  "key": "date_str",
                  "value": "2024-05-25",
                  "description": "Date in format YYYY-MM-DD. Defaults to today if not provided"
                }
              ]
            },
            "description": "Get daily nutrition log for a specific date"
          },
          "response": []
        },
        {
          "name": "Edit Meal Entry",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"food_name\": \"Updated Chicken Breast\",\n  \"calories\": 170,\n  \"protein_g\": 32,\n  \"fat_g\": 4,\n  \"carbs_g\": 0,\n  \"weight_g\": 105,\n  \"meal_type\": \"breakfast\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/meals/{{meal_id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "meals",
                "{{meal_id}}"
              ]
            },
            "description": "Update an existing meal entry"
          },
          "response": []
        },
        {
          "name": "Delete Meal Entry",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/meals/{{meal_id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "meals",
                "{{meal_id}}"
              ]
            },
            "description": "Delete a meal entry"
          },
          "response": []
        }
      ]
    },
    {
      "name": "Feedback",
      "item": [
        {
          "name": "Submit Feedback",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"task_id\": \"{{task_id}}\",\n  \"correct_food\": \"Caesar Salad with Chicken\",\n  \"correct_weight\": 250\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/feedback",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "feedback"
              ]
            },
            "description": "Submit correction feedback for an analysis task to improve the ML model"
          },
          "response": []
        }
      ]
    },
    {
      "name": "Admin",
      "item": [
        {
          "name": "List All Feedback",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Admin-Token",
                "value": "{{admin_token}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/admin/feedback?limit=100&offset=0&status=pending",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "admin",
                "feedback"
              ],
              "query": [
                {
                  "key": "limit",
                  "value": "100"
                },
                {
                  "key": "offset",
                  "value": "0"
                },
                {
                  "key": "status",
                  "value": "pending",
                  "disabled": true,
                  "description": "Filter by status: pending, approved, rejected"
                }
              ]
            },
            "description": "List all feedback submissions (admin only)"
          },
          "response": []
        },
        {
          "name": "Get Feedback Details",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Admin-Token",
                "value": "{{admin_token}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/admin/feedback/{{feedback_id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "admin",
                "feedback",
                "{{feedback_id}}"
              ]
            },
            "description": "Get detailed information about a specific feedback submission"
          },
          "response": []
        },
        {
          "name": "Update Feedback Status",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "X-Admin-Token",
                "value": "{{admin_token}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/admin/feedback/{{feedback_id}}/status?status=approved",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "admin",
                "feedback",
                "{{feedback_id}}",
                "status"
              ],
              "query": [
                {
                  "key": "status",
                  "value": "approved",
                  "description": "New status: pending, approved, rejected"
                }
              ]
            },
            "description": "Update the status of a feedback submission (admin only)"
          },
          "response": []
        }
      ]
    }
  ],
