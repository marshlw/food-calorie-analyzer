# Локальный DEV-стек. Значения безопасны только для разработки.
POSTGRES_PASSWORD=adminpass
APP_DB_PASSWORD=devpass
DATABASE_URL=postgresql://fooduser:devpass@postgres:5432/fooddb

REDIS_URL=redis://redis:6379/0
CACHE_TTL=86400

# Эмуляция ИИ позволяет поднять DEV без внешних API-ключей.
MODEL_PROVIDER=mock
YANDEX_API_KEY=
YANDEX_FOLDER_ID=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
DEEPSEEK_VISION_API_URL=
DEEPSEEK_VISION_MODEL=gpt-image-1
OLLAMA_HOST=http://ollama:11434
OLLAMA_MODEL=llava:7b
MODEL_NAME=mock

SECRET_KEY=dev-local-jwt-signing-key-8f3a2c7d1e9b4a6c0f5d2e7a9b1c3d5e
ALLOW_INSECURE_SECRET_KEY=true
ALLOW_INSECURE_DB_PASSWORD=true
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
ENABLE_DOCS=true

ADMIN_TOKEN=dev-admin-token
TELEGRAM_BOT_TOKEN=
MAX_UPLOAD_SIZE=10485760
UPLOAD_DIR=/app/app/uploads
API_URL=http://localhost:8000
